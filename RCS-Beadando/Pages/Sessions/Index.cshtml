@page
@model RCS_Beadando.Pages.Sessions.IndexModel
@{
    ViewData["Title"] = "Sessions";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Sessions</h1>
    <a asp-page="Edit" class="btn btn-primary">+ New session</a>
</div>

@if (!Model.Sessions.Any())
{
    <p class="text-muted">No sessions yet. Add your first one!</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Date</th>
                <th>Stakes</th>
                <th>Location</th>
                <th class="text-end">Invested</th>
                <th class="text-end">Cash out</th>
                <th class="text-end">Net</th>
                <th class="text-end">Hands</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model.Sessions)
            {
                <tr>
                    <td><a asp-page="Details" asp-route-id="@s.Id">@s.Date</a></td>
                    <td>@s.Stakes.DisplayName()</td>
                    <td>@s.Location</td>
                    <td class="text-end">@(s.BuyInPrice * s.BuyInNumber)</td>
                    <td class="text-end">@s.CashOut</td>
                    <td class="text-end"><partial name="_Net" model="s.Net" /></td>
                    <td class="text-end">@s.Hands.Count</td>
                    <td class="text-end">
                        <a asp-page="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@s.Id" class="d-inline"
                              onsubmit="return confirm('Delete this session and all its hands?');">
                            <button class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
