@page "{id:int?}"
@model RCS_Beadando.Pages.Players.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "New player" : "Edit player";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Player.Id" />

            <div class="mb-3">
                <label asp-for="Player.Name" class="form-label"></label>
                <input asp-for="Player.Name" class="form-control" />
                <span asp-validation-for="Player.Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Player.PlayStyle" class="form-label"></label>
                <select asp-for="Player.PlayStyle" asp-items="Html.GetEnumSelectList<Enums.PlayStyle>()" class="form-select"></select>
            </div>
            <div class="mb-3">
                <label asp-for="Player.Notes" class="form-label"></label>
                <textarea asp-for="Player.Notes" class="form-control" rows="3" placeholder="Tells, tendencies..."></textarea>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="Index" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
